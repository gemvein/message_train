.attachment-fields{ data: { 'message-train--nested-form-target': 'row' } }
  - if f.object.persisted?
    = f.hidden_field :_destroy, data: { 'message-train--nested-form-target': 'destroyField' }
  %button{ type: 'button', title: :remove_attachment.l, 'aria-label': :remove_attachment.l, data: { action: 'message-train--nested-form#remove', confirm: :are_you_sure.l } }
    = icon('remove')
  - if f.object.attachment.attached?
    .attachment
      = attachment_link(f.object)
  = f.label :attachment
  = f.file_field :attachment
